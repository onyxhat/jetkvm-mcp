# Copy to .env (or export these) before running the server.

# The device's address. Stock firmware serves plain HTTP on the LAN;
# if you've enabled TLS on the device (Settings → Advanced), use https://.
JETKVM_URL=http://192.168.1.50

# Local auth password. Leave empty if the device is in noPassword mode.
JETKVM_PASSWORD=

# Set true only if the device has a certificate your system trusts.
JETKVM_VERIFY_TLS=false

# Keyboard layout active on the TARGET machine's OS, not on yours: us|uk|de|fr.
# Wrong value = wrong characters typed, with no error. Default us.
JETKVM_KEYBOARD_LAYOUT=us

# ── Several devices ──────────────────────────────────────────────────────
# Instead of the four lines above, name every device in a JSON file (see the
# README's "Multiple devices"). Set this OR JETKVM_URL, not both.
# JETKVM_CONFIG=/config/devices.json

# ── Transport ────────────────────────────────────────────────────────────
# stdio (default): the MCP client launches the server. http: one long-running
# server at http://<host>:<port>/mcp shared by every client.
# JETKVM_MCP_TRANSPORT=stdio
# Bind address for http. No auth on the endpoint — keep it on localhost.
# JETKVM_MCP_HOST=127.0.0.1
# JETKVM_MCP_PORT=8000
